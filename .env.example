# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Server the commands are registered in (instant updates). Leave empty for global.
GUILD_ID=

# Discord user ID of the owner (pinged in tickets, can post vouches)
VOUCH_TARGET_ID=

# Optional: ONE role that is on par with the owner (every command except /spawnerbuy and /spawnersell, and all ticket controls)
COMMAND_ROLE_ID=

# Optional: set to true ONLY after enabling Message Content Intent in the Developer Portal.
# Needed just for the /purge filters: contains, links, attachments, embeds.
MESSAGE_CONTENT_INTENT=false

# Their in-game name, shown in the summary panel
OWNER_IGN=

# Channels. Every vouch is posted in ALL_VOUCHES, then copied to the matching one below.
ALL_VOUCHES_CHANNEL_ID=
SPAWNER_VOUCHES_CHANNEL_ID=
BUILD_VOUCHES_CHANNEL_ID=
GIVEAWAY_VOUCHES_CHANNEL_ID=

# Tickets (optional, leave empty to skip). COMMAND_ROLE_ID above is also pinged and given access in every ticket.
# Category the ticket channels are created in
TICKET_CATEGORY_ID=

# Schematic posting (optional). Format: channelId=TAGLETTER, comma separated. Each letter counts up on its own (G1, G2, S1...).
# In those channels: send a message with the pictures + schematic file, then reply to it with the owner(s) and the bot re-posts it.
# Needs MESSAGE_CONTENT_INTENT=true above and the bot needs Manage Messages in those channels.
SCHEMATIC_CHANNELS=
SCHEMATIC_BRAND=Tomberzz's Schematics
